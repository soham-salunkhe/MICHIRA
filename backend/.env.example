PORT=5001
DB_USER=kanra
DB_HOST=localhost
DB_NAME=yatraai
DB_PASSWORD=
DB_PORT=5432

# Server-side credentials only; never expose these through Vite/VITE_ variables.
APIFY_API_TOKEN=
APIFY_MAX_REVIEWS=50
APIFY_MAX_PLACES=3
APIFY_POLL_TIMEOUT_MS=90000
APIFY_POLL_INTERVAL_MS=3000

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TIMEOUT_MS=20000

# SerpAPI for AI Tourist Review Analysis feature (FREE TIER: 100 searches/month)
# Get your API key from: https://serpapi.com/users/sign_up
# Free tier: 100 searches per month (no credit card required)
SERPAPI_KEY=

# A destination is reused from PostgreSQL while it is fresh and sufficiently populated.
REVIEW_CACHE_TTL_HOURS=24
REVIEW_CACHE_MIN_REVIEWS=1
